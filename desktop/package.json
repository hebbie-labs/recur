{
  "productName": "Recur",
  "name": "recur-desktop",
  "version": "1.0.0",
  "description": "Recur Desktop Application",
  "author": "HebbieLabs",
  "main": "dist/main.js",
  "scripts": {
    "start": "tsc && electron .",
    "dist": "tsc && electron-builder"
  },
  "build": {
    "appId": "com.hebbielabs.recur",
    "productName": "Recur",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "Recur-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/hebbie-labs/recur/releases/download/desktop-latest"
    },
    "protocols": {
      "name": "Recur",
      "schemes": [
        "recur"
      ]
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "enableCookieEncryption": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
